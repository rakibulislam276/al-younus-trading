# Copy this file to .env. Never commit .env or share secrets.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Use a random secret of at least 32 characters.
AUTH_SECRET="replace-with-a-random-secret-at-least-32-characters"

# Used only by the one-time local seed command to create the first administrator.
ADMIN_NAME="AL YOUNUS Administrator"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-a-unique-password-at-least-12-characters"
